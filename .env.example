# Copy this file to .env.local inside the project folder.
# Use values from the SAME Supabase project. Restart Vite after changing them.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
# Legacy alternative: leave publishable key empty and set VITE_SUPABASE_ANON_KEY.
# Never put service_role or sb_secret_ keys in VITE_ variables.
